class AndroidUse < Formula
  desc "Fast, bounded Android control for authorized AI agents"
  homepage "https://github.com/@REPOSITORY@"
  version "@VERSION@"
  license "MIT"

  on_arm do
    url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/android-use-@VERSION@-macos-arm64.tar.gz"
    sha256 "@MACOS_ARM64_SHA256@"
  end

  on_intel do
    url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/android-use-@VERSION@-macos-x64.tar.gz"
    sha256 "@MACOS_X64_SHA256@"
  end

  def install
    bin.install "bin/au"
    pkgshare.install "share/android-use/dev.codex.aubridge.apk"
    pkgshare.install "manifest.json", "LICENSE", "THIRD_PARTY_NOTICES.md"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/au --version 2>&1")
    assert_path_exists pkgshare/"dev.codex.aubridge.apk"
  end
end
