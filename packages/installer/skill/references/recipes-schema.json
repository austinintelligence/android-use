{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://android-use.dev/schema/recipe-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "steps"],
  "properties": {
    "schema": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 96},
    "description": {"type": "string", "maxLength": 512},
    "max_mutations": {"type": "integer", "minimum": 0, "maximum": 16},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "object"}
    }
  }
}
