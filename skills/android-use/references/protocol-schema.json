{
  "version": 1,
  "name": "au-model-tape",
  "skill": {
    "name": "android-use",
    "display_name": "Android Use",
    "description": "Fast, compact Android control on Windows through the Rust au CLI, persistent ADB paths, and the authenticated AU Bridge helper. Use for authorized Android device discovery, exact-identity enrollment, batched GUI/app/web control, semantic UI, media, files, notifications, and mock-location work."
  },
  "aliases": ["x", "tape"],
  "limits": {"instructions": 64, "state_actions": 20, "dictionary_entries": 32, "dictionary_value_bytes": 8192},
  "batch": {
    "separators": [";", "newline"],
    "prefixes": {
      "retry": {"args": ["count"], "max": 2, "meaning": "retry only after a failed attempt"},
      "repeat": {"args": ["count"], "max": 20, "meaning": "intentionally execute N times"}
    },
    "worst_case_state_actions": 20,
    "logical_success_count": true
  },
  "diagnostics": {
    "disassemble": "--disasm",
    "aliases": ["--decode", "--disassemble"],
    "device_free": true,
    "expanded_program": true
  },
  "refs": {"dictionary": "@0..@31", "register": "$0..$31"},
  "opcodes": {
    "D": {"args": ["slot", "value"], "class": "dictionary"},
    "R": {"args": [], "class": "control"},
    "F": {"args": ["slot", "selector"], "class": "query"},
    "T": {"args": ["ref"], "class": "semantic-action"},
    "L": {"args": ["ref"], "class": "semantic-action"},
    "E": {"args": ["ref", "text"], "class": "semantic-action"},
    "S": {"args": ["ref", "direction"], "class": "semantic-action"},
    "W": {"args": ["selector", "timeout_ms"], "class": "query"},
    "A": {"args": ["selector", "timeout_ms"], "class": "verification"},
    "P": {"args": ["selector", "postcondition", "timeout_ms"], "class": "proof"},
    "K": {"args": ["key"], "class": "shell-action"},
    "H": {"args": [], "class": "shell-action"},
    "B": {"args": [], "class": "shell-action"},
    "G": {"args": ["x", "y"], "class": "shell-action"},
    "Q": {"args": [], "class": "frontier"},
    "Y": {"args": ["count", "opcode"], "class": "bounded-repeat", "max": 20}
  },
  "output": {"success": "versioned-au-wire-envelope", "error": "versioned-au-wire-envelope", "binary_default": false}
}
