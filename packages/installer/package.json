{
  "name": "android-use",
  "version": "1.0.0",
  "description": "Verified NPX installer for the android-use Rust Android control stack",
  "type": "module",
  "bin": {
    "android-use": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "skill/**",
    "LICENSE",
    "release-public-key.pem",
    "release-manifest.example.json"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/austinintelligence/android-use.git"
  },
  "homepage": "https://github.com/austinintelligence/android-use",
  "bugs": {
    "url": "https://github.com/austinintelligence/android-use/issues"
  },
  "license": "MIT",
  "scripts": {
    "lint": "node --check cli.mjs && node --check ../../scripts/package-release.mjs && node --check ../../scripts/generate-package-metadata.mjs",
    "test": "node --test",
    "test:packages": "node ../../scripts/test-package-release.mjs",
    "test:tarball": "node ../../scripts/test-installer-tarball.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
