{
  "name": "android-use-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "android-use-workspace",
      "workspaces": [
        "packages/installer"
      ],
      "engines": {
        "node": ">=20.11"
      }
    },
    "node_modules/android-use": {
      "resolved": "packages/installer",
      "link": true
    },
    "packages/installer": {
      "name": "android-use",
      "version": "1.0.0",
      "license": "MIT",
      "bin": {
        "android-use": "cli.mjs"
      },
      "engines": {
        "node": ">=20.11"
      }
    }
  }
}
