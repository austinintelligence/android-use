# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.10.0.schema.json

PackageIdentifier: AndroidUse.AndroidUse
PackageVersion: @VERSION@
InstallerType: wix
Scope: user
InstallModes:
  - silent
  - silentWithProgress
UpgradeBehavior: install
Commands:
  - au
Installers:
  - Architecture: x64
    InstallerUrl: https://github.com/@REPOSITORY@/releases/download/v@VERSION@/android-use-@VERSION@-windows-x64.msi
    InstallerSha256: @WINDOWS_X64_MSI_SHA256@
  - Architecture: arm64
    InstallerUrl: https://github.com/@REPOSITORY@/releases/download/v@VERSION@/android-use-@VERSION@-windows-arm64.msi
    InstallerSha256: @WINDOWS_ARM64_MSI_SHA256@
ManifestType: installer
ManifestVersion: 1.10.0
